# Zugangsdaten des Postfachs, ueber das das Kontaktformular versendet.
# Diese Datei ist nur die Vorlage. Fuer die lokale Entwicklung eine
# .env.local anlegen, beim Hoster die Werte als Umgebungsvariablen
# hinterlegen. Das Passwort gehoert nicht ins Repository.

SMTP_HOST=mail.euer-provider.de
SMTP_PORT=587
SMTP_USER=wohnatelier@adakli.de
SMTP_PASSWORD=

# Optional. Standard ist SMTP_USER. Nur setzen, wenn die Absenderadresse
# von der Anmeldung abweicht.
# SMTP_FROM=wohnatelier@adakli.de

# Optional. Standard ist wohnatelier@adakli.de.
# KONTAKT_EMPFAENGER=wohnatelier@adakli.de
